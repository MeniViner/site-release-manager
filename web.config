<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="index.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!--
          Trusted-identity headers MUST be re-stamped on EVERY request, before any
          other rule and with no conditions. The previous configuration set
          HTTP_X_IISNODE_AUTH_USER only inside the SPA-fallback rule, which is
          guarded by "{REQUEST_FILENAME} is not a file". A request that resolves to
          a real file on disk — index.cjs is itself the iisnode handler — skipped
          that rule entirely, so a browser-supplied X-IISNode-Auth-User header was
          forwarded to Node untouched.

          HTTP_X_IISNODE_SHAREPOINT_SITES is blanked defensively. The application no
          longer reads it at all: per-site access now comes only from each site's
          explicit dataAccess lists. It is still cleared so that a future reader
          cannot accidentally resurrect a caller-controlled grant.

          URL Rewrite maps server variables to HTTP headers by turning underscores
          into hyphens: HTTP_X_IISNODE_AUTH_USER -> x-iisnode-auth-user. It is NOT
          the same convention as IISNode promoted headers. Note also that {AUTH_USER}
          is only populated once IIS authentication has run; if it is empty the app
          fails closed with JSON rather than trusting the request.
        -->
        <rule name="StampTrustedIdentityHeaders" patternSyntax="ECMAScript" stopProcessing="false">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_IISNODE_AUTH_USER" value="{AUTH_USER}" replace="true" />
            <set name="HTTP_X_IISNODE_SHAREPOINT_SITES" value="" replace="true" />
          </serverVariables>
          <action type="None" />
        </rule>
        <!--
          CORS preflight must never meet a Windows challenge. A browser sends
          OPTIONS with no credentials, so a 401 here kills the real request that
          follows.

          This rule rewrites straight to index.cjs, the path the iisnode handler
          is mapped to. An earlier version rewrote to an intermediate application
          URL, which could never work: stopProcessing means no later rule runs,
          so nothing mapped that URL onto the handler, and iisnode passes the
          ORIGINAL request URL to Node regardless, so the intermediate path would
          not have been seen by Express either.

          Inbound rewrite runs at BeginRequest, before the authentication stage,
          so once the URL is index.cjs the <location> requirement on
          api/daily-data/v1/sites no longer applies to this request and IIS does
          not challenge it. Express then answers the preflight from its own
          Daily Data CORS policy, which short-circuits OPTIONS before the
          identity middleware. Nothing about the authenticated request that
          follows is relaxed: it keeps its original URL and is challenged normally.
        -->
        <rule name="AnonymousCorsPreflight" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^api/daily-data/v1/sites(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
          </conditions>
          <action type="Rewrite" url="index.cjs" />
        </rule>
        <rule name="IISNodeLogs" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^iisnode" />
        </rule>
        <rule name="SiteReleaseManager" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.cjs" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="629145600" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="runtime" />
          <add segment="server" />
          <add segment="scripts" />
          <add segment="storage" />
          <add segment="client" />
          <add segment="sharepoint-deployer" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!--
      Baseline: ANONYMOUS. Management operations are authorized by the
      application's Bearer management session, not by IIS, so a Bearer request
      must reach Express without a Windows negotiation. Challenging here is what
      turned an ordinary click into a native credential dialog.

      This is NOT "anonymous management": every consequential mutation
      (site create/update/delete/deploy, release upload/update/delete,
      data-access administration) requires a signed management session in the
      application. Health, readiness and preflight are intentionally open.
    -->
    <security>
      <authentication>
        <anonymousAuthentication enabled="true" />
        <windowsAuthentication enabled="false" />
      </authentication>
    </security>
  </system.webServer>

  <!--
    The ONLY place a Windows identity is acquired. The client posts here with
    credentials and no custom headers, so it is a CORS-simple request and needs
    NO preflight - which is why a challenge on this path is safe.

    Requires, at the server level:
      Windows Authentication role service installed
      Negotiate listed before NTLM in the providers
      allowedServerVariables entries for HTTP_X_IISNODE_AUTH_USER and
      HTTP_X_IISNODE_SHAREPOINT_SITES (URL Rewrite refuses to set them otherwise)
  -->
  <location path="api/auth/session">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
      </security>
    </system.webServer>
  </location>

  <!--
    End-user Daily Data. A different boundary from management on purpose: these
    routes authorize the ACTUAL signed-in user against each site's dataAccess
    lists, so they need the Windows principal rather than a management session.
    healthz and readyz stay anonymous under the root above; only /sites is
    protected here, and its OPTIONS is diverted by AnonymousCorsPreflight.
  -->
  <location path="api/daily-data/v1/sites">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="false" />
          <windowsAuthentication enabled="true" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
