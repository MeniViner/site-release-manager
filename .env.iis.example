# IIS / production API
NODE_ENV=production
# Do not set PORT here. IISNode supplies either a TCP port or a named pipe.
# Set this to the final HTTPS URL that the SharePoint browser can reach.
PUBLIC_API_URL=https://CHANGE-ME-INTERNAL-SERVER

# SharePoint-hosted Release Manager UI origins allowed to call this API.
CLIENT_ORIGINS=https://portal.army.idf,https://mazi.army.idf

# MongoDB on the IIS server
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=site_release_manager
BUILDER_DATA_MONGO_DB_NAME=site_release_manager_site_builder_data
AUTO_START_MONGO=false

# Release storage on the IIS server. Keep relative to the deployed folder unless you prefer an absolute path.
STORAGE_ROOT=./storage

SHAREPOINT_HOSTS=portal.army.idf,mazi.army.idf
SHAREPOINT_DEPLOYER_PATH=/sites/tools/SiteAssets/site-release-deployer/index.html
PUBLIC_DAILY_DATA_API_URL=https://CHANGE-ME-INTERNAL-SERVER/api/daily-data/v1

# Windows Authentication must be enabled in IIS and Anonymous Authentication disabled.
# IIS/reverse proxy must remove browser supplied values and inject these headers.
TRUSTED_IDENTITY_ENABLED=true
TRUSTED_IDENTITY_HEADER=x-iisnode-auth-user
# Per-site access for ordinary Site Builder users is granted ONLY by each site's
# explicit dataAccess lists, administered through the Release Manager UI.
#
# A header-derived baseline (x-iisnode-sharepoint-sites) was removed: this server
# has no AD, LDAP, Graph or SharePoint client, and URL Rewrite cannot derive
# per-site membership, so the header's only possible source was the caller.
# web.config still blanks it defensively.
#
# Management operations (create site, change data access) use a management
# session: POST /api/auth/session exchanges the authenticated Windows identity
# for a short-lived bearer token. MANAGEMENT_SESSION_SECRET signs those tokens
# and is REQUIRED in production (32+ characters, unique per installation).
MANAGEMENT_SESSION_SECRET=CHANGE-ME-GENERATE-A-LONG-RANDOM-SECRET
MANAGEMENT_SESSION_TTL_SECONDS=28800

MAX_RELEASE_MB=500
MAX_RELEASE_FILES=12000
