# Central API
PORT=4300
# Local Vite + SharePoint origins that are allowed to call the Node API.
CLIENT_ORIGINS=http://localhost:5173,https://portal.army.idf,https://mazi.army.idf
# Runtime API address written into client/dist/release-manager-runtime-config.json/.txt.
# Local SharePoint test on the SAME computer.
# After `npm run sharepoint:test`, keep that terminal open while using the UI from SharePoint.
PUBLIC_API_URL=http://127.0.0.1:4300

# Mongo used only by this tracking application
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=site_release_manager
# Closed Windows workstation already has MongoDB running as a service.
AUTO_START_MONGO=false
MONGO_START_TIMEOUT_MS=15000

# Local storage paths, relative to the repository root unless absolute
STORAGE_ROOT=./storage

# SharePoint hosts supported by the application
SHAREPOINT_HOSTS=portal.army.idf,mazi.army.idf
SHAREPOINT_DEPLOYER_PATH=/sites/tools/SiteAssets/site-release-deployer/index.html
SHAREPOINT_DEPLOYER_PUBLISH_PATH=/sites/tools/SiteAssets/site-release-deployer
SHAREPOINT_DEPLOYER_HOST=portal.army.idf

# Release Manager UI itself: automatic local-Windows deploy after `npm run build`.
RELEASE_MANAGER_AUTO_SHAREPOINT_DEPLOY=true
RELEASE_MANAGER_SHAREPOINT_HOST=portal.army.idf
RELEASE_MANAGER_SHAREPOINT_DIST_PATH=/sites/alphateam/site_release_manager/dist

# Upload limits for universal dist releases
MAX_RELEASE_MB=500
MAX_RELEASE_FILES=12000
